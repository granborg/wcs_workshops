# Copy the relevant block to apps/api/.env and apps/app/.env. Never commit real values.

# ---- apps/api/.env ----
PORT=3000
HOST=0.0.0.0
# SQLite file. The directory is created on first start.
DATABASE_PATH=./data/wcs.db
# Browser origins allowed by CORS. Only needed for the Vite dev server and the Capacitor shells;
# the Go binary serves the web app from the same origin as the API.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost
# Origin that QR codes and share links point to. Unset = the origin of the request, which is correct when the
# Go binary serves the web app. Set it for a custom domain.
PUBLIC_URL=
# Firebase project. With the emulator any "demo-" id works without a real project.
FIREBASE_PROJECT_ID=demo-wcs
# Development: point the Admin SDK at the local Auth emulator (npm run dev:auth). Unset in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Production: service account used to verify ID tokens. Either a file path...
GOOGLE_APPLICATION_CREDENTIALS=
# ...or the JSON itself, for hosts whose secrets are environment variables (Fly.io).
FIREBASE_CREDENTIALS_JSON=
# Vimeo server-to-server access token. Scopes: public private create edit delete upload video_files
VIMEO_ACCESS_TOKEN=
# unlisted = playable anywhere with the hash (default, works inside Capacitor).
# disable  = hidden from vimeo.com, embed limited to VIMEO_EMBED_DOMAINS (Core plan or above).
VIMEO_PRIVACY=unlisted
VIMEO_EMBED_DOMAINS=

# ---- apps/app/.env ----
# Development: use the local Auth emulator. Unset for real Firebase.
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Leave unset for same-origin /api (Vite proxy in dev, Go binary in prod).
# Native builds need the absolute URL of the deployed API.
VITE_API_URL=
# Real Firebase web config (production)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
