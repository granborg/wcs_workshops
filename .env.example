# Copy the relevant block to apps/api/.env and apps/app/.env. Never commit real values.

# ---- apps/api/.env ----
PORT=3000
HOST=0.0.0.0
# SQLite file. The directory is created on first start.
DATABASE_PATH=./data/wcs.db
# Public base URL of the API, used for banner image URLs.
PUBLIC_API_URL=http://localhost:3000
# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost
# Development only: accept an `X-Dev-User: <email>` header instead of a Firebase ID token.
# The API refuses to start with this on when APP_ENV=production.
DEV_AUTH_BYPASS=true
APP_ENV=development
# Firebase Admin service account JSON path. Required when DEV_AUTH_BYPASS=false and for push.
GOOGLE_APPLICATION_CREDENTIALS=
# Vimeo server-to-server access token. Scopes: public private create edit delete upload video_files
VIMEO_ACCESS_TOKEN=
# unlisted = playable anywhere with the hash (default, works inside Capacitor).
# disable  = hidden from vimeo.com, embed limited to VIMEO_EMBED_DOMAINS (Core plan or above).
VIMEO_PRIVACY=unlisted
VIMEO_EMBED_DOMAINS=
# Directory for creator banner images.
UPLOAD_DIR=./uploads

# ---- apps/app/.env ----
VITE_API_URL=http://localhost:3000
# true = send X-Dev-User header instead of signing in with Firebase.
VITE_DEV_AUTH=true
VITE_DEV_USER_EMAIL=creator@example.com
# Firebase web config (used when VITE_DEV_AUTH=false)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
