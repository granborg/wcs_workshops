{
  "name": "wcs-workshops",
  "private": true,
  "version": "0.1.0",
  "description": "Creators share video collections with viewers through QR codes. Vue 3 + Capacitor app, Fastify API, Vimeo hosting.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:app": "npm run dev -w apps/app",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "cap:sync": "npm run cap:sync -w apps/app"
  },
  "engines": {
    "node": ">=22"
  }
}
